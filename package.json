{
  "name": "nuzlocke",
  "author": "Diego Ballesteros Castellanos",
  "description": "Nuzlocke tracker to record encounters with detailed information",
  "version": "6.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "bugs": {
    "url": "https://github.com/diballesteros/nuzlocke/issues"
  },
  "private": true,
  "dependencies": {
    "@sentry/react": "^9.42.0",
    "@smogon/calc": "^0.9.0",
    "@supabase/supabase-js": "^2.52.1",
    "html-to-image": "^1.11.11",
    "i18next": "22.4.15",
    "immer": "^10.0.4",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "12.2.2",
    "react-router-dom": "^7.7.1",
    "react-toastify": "^11.0.5",
    "react-window": "^1.8.10",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "zustand": "^4.5.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:cov": "cross-env CYPRESS_COVERAGE=true vite --port 3000 --strictPort",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "e2e": "cypress open",
    "e2e:run": "start-server-and-test dev:cov http://localhost:3000 cy:run",
    "cy:run": "cypress run --browser chrome",
    "coverage": "node scripts/coverage.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit:cov && npm run build && npm run e2e:run && npm run coverage",
    "verify:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@sentry/vite-plugin": "^4.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.24",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "cross-env": "^10.1.0",
    "cypress": "^14.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.3.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "start-server-and-test": "^3.0.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.7"
  }
}
