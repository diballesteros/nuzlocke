{
  "name": "nuzlocke",
  "author": "Diego Ballesteros Castellanos",
  "description": "Nuzlocke tracker to record encounters with detailed information",
  "version": "6.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "bugs": {
    "url": "https://github.com/diballesteros/nuzlocke/issues"
  },
  "private": true,
  "dependencies": {
    "@sentry/react": "^9.47.2",
    "@smogon/calc": "^0.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "html-to-image": "^1.11.11",
    "i18next": "^26.5.3",
    "immer": "^11.2.3",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "react-window": "^1.8.10",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "dev:cov": "cross-env CYPRESS_COVERAGE=true vite --port 3000 --strictPort",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "e2e": "cypress open",
    "e2e:run": "start-server-and-test dev:cov http://localhost:3000 cy:run",
    "cy:run": "cypress run --browser chrome",
    "coverage": "node scripts/coverage.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit:cov && npm run build && npm run e2e:run && npm run coverage",
    "verify:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.24",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/istanbul-lib-coverage": "^1.0.2",
    "@vitest/istanbul-lib-source-maps": "^1.0.2",
    "@vitest/ui": "^5.0.5",
    "cross-env": "^10.1.0",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "start-server-and-test": "^3.0.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
